<!DOCTYPE html>
<html>
<head>
<style>
body{
    margin:0;
    overflow:hidden;
    background:radial-gradient(circle,#111,#000);
    height:100vh;
    position:relative;
}

/* White glowing moon */
.moon{
    position:absolute;
    top:50px;
    right:80px;
    width:100px;
    height:100px;
    border:3px solid white;
    border-radius:50%;
    box-shadow:
        0 0 20px white,
        0 0 40px rgba(255,255,255,0.7);
}

/* White horizontal line */
.line{
    position:absolute;
    top:100px;
    left:0;
    width:100%;
    height:1px;
    background:rgba(255,255,255,0.3);
}

.bat{
    position:absolute;
    width:60px;
    height:30px;
    opacity:0.8;
    animation:fly linear infinite;
}

.bat::before,
.bat::after{
    content:"";
    position:absolute;
    width:30px;
    height:20px;
    background:#000;
    border-radius:50% 50% 0 50%;
    box-shadow:0 0 10px rgba(255,255,255,0.2);
}

.bat::before{
    left:0;
    transform:rotate(-25deg);
}

.bat::after{
    right:0;
    transform:scaleX(-1) rotate(-25deg);
}

@keyframes fly{
    from{
        transform:translateX(-100px);
    }
    to{
        transform:translateX(calc(100vw + 100px));
    }
}
</style>
</head>

<body>

<div class="moon"></div>
<div class="line"></div>

<script>
function createBat(){
    let bat=document.createElement("div");
    bat.className="bat";

    bat.style.top=Math.random()*window.innerHeight+"px";
    bat.style.animationDuration=(5+Math.random()*5)+"s";

    document.body.appendChild(bat);

    setTimeout(()=>bat.remove(),10000);
}

setInterval(createBat,500);
</script>

